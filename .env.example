# PostgreSQL database used by the pipeline and the API.
DATABASE_URL=postgresql://localhost/uber_nyc

# Database used only by the test suite. It is wiped and rebuilt on every test run.
TEST_DATABASE_URL=postgresql://localhost/uber_nyc_test

# Rows per COPY batch when loading.
BATCH_SIZE=100000

# Where downloaded source CSVs are stored. Defaults to data/raw/ under the project root.
RAW_DIR=data/raw
